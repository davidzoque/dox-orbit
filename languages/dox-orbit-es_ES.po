msgstr "Campos: {first_name}, {last_name}, {email}. Con respaldo: {first_name|amigo}."

msgid "Fields: {first_name}, {last_name}, {email}. With a fallback: {first_name|friend}. Also {unsubscribe_url} and {view_in_browser_url} for links. If your code has no {unsubscribe_url}, Orbit adds its footer with the unsubscribe link at the end."
msgstr "Campos: {first_name}, {last_name}, {email}. Con respaldo: {first_name|amigo}. Para enlaces, también {unsubscribe_url} y {view_in_browser_url}. Si tu código no trae {unsubscribe_url}, Orbit añade al final su pie con el enlace de baja."

