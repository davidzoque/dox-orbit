msgid "%1$s in %2$d days"
msgstr "%1$s en %2$d días"

msgid "%1$s messages read, %2$s bounces found (%3$s do not exist, %4$s temporary)."
msgstr "%1$s mensajes leídos, %2$s rebotes encontrados (%3$s no existen, %4$s pasajeros)."

msgid "%1$s new, %2$s already there, %3$s skipped, %4$s invalid"
msgstr "%1$s nuevos, %2$s ya estaban, %3$s omitidos, %4$s no válidos"

